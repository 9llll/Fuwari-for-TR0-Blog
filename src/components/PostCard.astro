---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { resolveCoverImage } from "../utils/cover-image";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostCoverPlaceholder from "./misc/PostCoverPlaceholder.astro";
import PostBadge from "./PostBadge.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string[];
	image: string;
	description: string;
	draft: boolean;
	style: string;
	pinned?: boolean;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	pinned,
} = Astro.props;
const className = Astro.props.class;

const { remarkPluginFrontmatter } = await entry.render();

// 是否为加密资源文章（用于占位封面的图标选择）
const isEncrypted = remarkPluginFrontmatter.badgeType === "encrypted";

// 占位封面类型：带下载资源的文章用「资源」默认图，其余用「教程」默认图
const coverType =
	remarkPluginFrontmatter.badgeType === "encrypted" ||
	remarkPluginFrontmatter.badgeType === "free"
		? "download"
		: "tutorial";

// frontmatter 指定了 /images/default-*.png 时，走占位封面组件，
// 以获得渐变底 + 类型角标的统一效果（普通图片则原样展示）
const isDefaultCover = /^\/images\/default-(tutorial|download)\.png$/.test(
	image,
);

// image 为 "api" 时表示使用随机封面图 API，解析为带 seed 的实际地址
const coverImage = isDefaultCover ? image : resolveCoverImage(image, entry.id);
const hasCover = !isDefaultCover && coverImage !== "";

// 从URL路径中提取文章ID
const extractArticleId = (urlPath: string) => {
	const match = urlPath.match(/\/(.*)?\/$/);
	return match ? match[1] : null;
};

const articleId = extractArticleId(url);
---

<div class:list={[
  "card-base w-full rounded-[var(--radius-large)] overflow-hidden relative",
  "bg-white dark:bg-gray-900 isolation:isolate",
  className
]} style={style}>
  <div class:list={[
    "grid gap-4 p-4 relative",
    "grid-cols-[32%_1fr] items-start"
  ]}>
    <div
      class="relative rounded-lg overflow-hidden"
      style="aspect-ratio: 8/5;"
    >
      {pinned && <div class="absolute top-2 right-2 text-[var(--primary)] z-20">
          <Icon name="material-symbols:keep-outline" class="w-8 h-8" />
      </div>}
      <a href={url} aria-label={title} class="block h-full w-full group">
        {hasCover ? (
          <ImageWrapper
            src={coverImage}
            basePath={path.join("content/posts/", getDir(entry.id))}
            alt="Cover image of the post"
            class="w-full h-full object-cover"
          />
        ) : (
          // 无封面图时展示渐变占位，保持两栏布局与整体视觉平衡
          <PostCoverPlaceholder
            title={title}
            category={category?.[0]}
            type={coverType}
            encrypted={isEncrypted}
            image={isDefaultCover ? image : undefined}
            class="w-full h-full"
          />
        )}
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 z-10"></div>
        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20">
          <Icon name="material-symbols:chevron-right-rounded" class="text-white text-3xl" />
        </div>
      </a>
    </div>

    <div class="flex flex-col justify-start">
      <div class="flex items-start justify-between gap-3 mb-3">
        <a
          href={url}
          class="group block font-bold text-xl text-gray-900 dark:text-gray-100 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] transition-colors min-w-0"
        >
          <span class="line-clamp-2 relative">
            {title}
            <Icon
              name="material-symbols:chevron-right-rounded"
              class="inline-block text-[var(--primary)] text-[1.5rem] ml-1 opacity-0 group-hover:opacity-100 translate-x-0 group-hover:translate-x-1 transition-all"
            />
          </span>
        </a>
        <!-- 文章角标：加密下载 / 免费下载 / 教程文章（由 remark 自动识别） -->
        <PostBadge type={remarkPluginFrontmatter.badgeType} class="shrink-0 mt-0.5" />
      </div>

      <div class="text-gray-700 dark:text-gray-300 mb-4 line-clamp-2 hidden min-[700px]:block">
        <span class="line-clamp-2">
            {description || remarkPluginFrontmatter.excerpt}
        </span>
      </div>
      
      <PostMetadata 
        published={published} 
        updated={updated} 
        tags={tags} 
        category={category || []} 
        hideTagsForMobile={false} 
        hideUpdateDate={true}
        articleId={articleId}
      />
    </div>
  </div>
</div>

<style>
.visit-count .loading-text {
  opacity: 0.6;
  animation: pulse 1.5s ease-in-out infinite;
}

.visit-count.loaded {
  opacity: 1;
}

.visit-count.error {
  opacity: 0.5;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 0.3; }
}
</style>
