---
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	/** 文章标题，用于生成稳定的占位配色与首字 */
	title: string;
	/** 分类名，用于选择图标 */
	category?: string;
	/** 占位类型：tutorial（教程文章）/ download（资源下载） */
	type?: "tutorial" | "download";
	/** 是否为加密资源（加密下载 → 锁图标） */
	encrypted?: boolean;
	/** 自定义封面图地址（相对 public/ 的绝对路径）。传入时优先使用该图 */
	image?: string;
}

const {
	class: className,
	title,
	category,
	type = "tutorial",
	encrypted = false,
	image,
} = Astro.props;

// 依据标题生成稳定的色相偏移，让不同文章的占位封面有区分度，
// 同时保持整体在同一色系内（不会花）。
const hash = Array.from(title).reduce(
	(acc, ch) => (acc * 31 + ch.charCodeAt(0)) % 360,
	0,
);
const hueOffset = hash % 40; // 0-39 的偏移，落在相近色相区间

// 图标优先级：加密资源 > 分类关键词 > 通用文章
const ICON_RULES: { match: RegExp; icon: string }[] = [
	{
		match: /加密|下载|资源|影视|软件|游戏|工具/,
		icon: "material-symbols:download-rounded",
	},
	{
		match: /教程|指南|攻略|使用|howto|guide/i,
		icon: "material-symbols:menu-book-rounded",
	},
	{
		match: /配置|部署|建站|运维|开发|代码|编程/i,
		icon: "material-symbols:terminal-rounded",
	},
	{ match: /新闻|公告|通知|记录/i, icon: "material-symbols:campaign-rounded" },
];

const catText = (category || "").trim();
const iconName = encrypted
	? "material-symbols:lock"
	: (ICON_RULES.find((r) => r.match.test(catText))?.icon ??
		"material-symbols:article-rounded");

// 取标题首个非空白字符作为大字
const initial = (title || "文").trim().charAt(0) || "文";

// 默认图片：资源下载用文件夹图标，教程文章用黑板图
// 放在 public/images/ 下用绝对路径引用，避免构建期依赖（文件可随时替换）
// 这两张是去白底的透明 PNG，融合在渐变底上效果更好
const defaultImage =
	type === "download"
		? "/images/default-download.png"
		: "/images/default-tutorial.png";
// 传入自定义封面时优先使用
const coverSrc = image || defaultImage;
---

<div
	class:list={[
		"post-cover-placeholder relative w-full h-full overflow-hidden",
		"flex items-center justify-center select-none",
		className,
	]}
	style={`--cover-hue-offset: ${hueOffset};`}
>
	<!-- 渐变底色 -->
	<div
		class="absolute inset-0"
		style="background: linear-gradient(135deg,
			oklch(0.88 0.06 calc(var(--hue) + var(--cover-hue-offset)) / 0.55),
			oklch(0.82 0.09 calc(var(--hue) + var(--cover-hue-offset) + 25) / 0.45));"
	>
	</div>

	<!-- 深色模式下的浅色衬底：黑色素材在深底上需要一层浅底才看得清 -->
	<div
		class="absolute inset-0 hidden dark:block"
		style="background: oklch(0.32 0.03 calc(var(--hue) + var(--cover-hue-offset)) / 0.55);"
	>
	</div>

	<!-- 装饰圆环 -->
	<div
		class="absolute rounded-full"
		style="width: 140%; aspect-ratio: 1; right: -35%; top: -55%;
			background: radial-gradient(circle, oklch(0.95 0.04 calc(var(--hue) + var(--cover-hue-offset) + 40) / 0.5), transparent 62%);"
	>
	</div>

	<!-- 首字作为背景装饰 -->
	<span
		class="absolute text-[5.5rem] sm:text-[6.5rem] font-black leading-none select-none"
		style="color: oklch(0.55 0.12 calc(var(--hue) + var(--cover-hue-offset)) / 0.16);"
	>
		{initial}
	</span>

	<!-- 封面图（默认图为已预处理为透明底的 PNG，浅色/深色模式都能自然融入渐变底） -->
	<img
		src={coverSrc}
		alt=""
		loading="lazy"
		class="relative z-10 w-[64%] h-[64%] object-contain"
		style="filter: drop-shadow(0 2px 6px oklch(0.4 0.05 var(--hue) / 0.22));"
	/>

	<!-- 类型角标 -->
	<div
		class="absolute bottom-1.5 right-1.5 z-20 inline-flex items-center gap-1 rounded-full px-1.5 py-0.5
			text-[0.6rem] font-medium leading-none"
		style="background: oklch(0.98 0.02 var(--hue) / 0.9);
			color: oklch(0.45 0.12 calc(var(--hue) + var(--cover-hue-offset)));"
	>
		<Icon
			name={type === "download"
				? "material-symbols:download-rounded"
				: "material-symbols:menu-book-rounded"}
			class="w-3 h-3"
		/>
		{type === "download" ? "资源" : "教程"}
	</div>
</div>
